{
  "version": 2,
  "installCommand": "uv pip install --system -r requirements.txt",
  "functions": {
    "api/**/*.py": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}
